# Server Configuration
PORT=5001
NODE_ENV=production

# MongoDB Database URI (Replace with your actual MongoDB connection string)
MONGO_URI=mongodb://localhost:27017/journal_app

# Security Secrets (Must be changed in production!)
# You can generate strong secrets using: openssl rand -base64 32
JWT_SECRET=replace_me_with_a_strong_secret
REFRESH_TOKEN_SECRET=replace_me_with_a_strong_refresh_secret
