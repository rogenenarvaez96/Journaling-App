# NGINX Configuration for Cloudflare Tunnels
# Location: /etc/nginx/sites-available/journal

server {
    listen 80;
    server_name localhost; # Or your domain name

    # 1. Serve the React Frontend
    location / {
        root /home/YOUR_USERNAME/Journaling-App/client/dist;
        index index.html index.htm;
        try_files $uri $uri/ /index.html;
    }

    # 2. Reverse Proxy the API Backend
    location /api/ {
        proxy_pass http://127.0.0.1:5001/api/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        
        # Ensure IPs are forwarded correctly
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 3. Serve Public Logos
    location /public/ {
        proxy_pass http://127.0.0.1:5001/public/;
        proxy_set_header Host $host;
    }
}
